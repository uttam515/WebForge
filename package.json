{
  "name": "webforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "WebForge - Schema-driven no-code application compiler",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc -b && pnpm --filter @webforge/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b && pnpm --filter @webforge/web typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^20.17.19",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  }
}
